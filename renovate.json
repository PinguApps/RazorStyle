{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>PinguApps/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Retain .NET 10 SDK integration fixtures alongside the .NET 11 SDK from global.json.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "dotnet-sdk"
      ],
      "allowedVersions": "<11"
    }
  ]
}
