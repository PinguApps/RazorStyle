<Project>
  <PropertyGroup>
    <!-- Select by the build host, so SDK 11 can format a net10.0 project without runtime 10. -->
    <_RazorStyleCliFramework>net10.0</_RazorStyleCliFramework>
    <_RazorStyleCliFramework Condition="$([System.Environment]::Version.Major) &gt;= 11">net11.0</_RazorStyleCliFramework>
    <_RazorStyleDotNetHost>dotnet</_RazorStyleDotNetHost>
    <_RazorStyleDotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_RazorStyleDotNetHost>
    <RazorStyleCliPath Condition="'$(RazorStyleCliPath)' == ''">$(MSBuildThisFileDirectory)..\tools\$(_RazorStyleCliFramework)\PinguApps.RazorStyle.Cli.dll</RazorStyleCliPath>
    <RazorStyleDisabledRuleArguments></RazorStyleDisabledRuleArguments>
    <RazorStyleDisabledRuleArguments Condition="'$(DisablePARS0001)' == 'true'">$(RazorStyleDisabledRuleArguments) --disable PARS0001</RazorStyleDisabledRuleArguments>
    <RazorStyleDisabledRuleArguments Condition="'$(DisablePARS0002)' == 'true'">$(RazorStyleDisabledRuleArguments) --disable PARS0002</RazorStyleDisabledRuleArguments>
    <RazorStyleDisabledRuleArguments Condition="'$(DisablePARS0003)' == 'true'">$(RazorStyleDisabledRuleArguments) --disable PARS0003</RazorStyleDisabledRuleArguments>
    <!-- Component diagnostics run in the compiler during builds. Avoid loading this project recursively in the embedded CLI. -->
    <RazorStyleDisabledRuleArguments>$(RazorStyleDisabledRuleArguments) --disable PARS0004 --disable PARS0005</RazorStyleDisabledRuleArguments>
    <NoWarn Condition="'$(DisablePARS0004)' == 'true'">$(NoWarn);PARS0004</NoWarn>
    <NoWarn Condition="'$(DisablePARS0005)' == 'true'">$(NoWarn);PARS0005</NoWarn>
    <RazorStyleAttributeOrderArguments></RazorStyleAttributeOrderArguments>
    <RazorStyleAttributeOrderArguments Condition="'$(RazorStylePreserveAttributeSplattingOrder)' == 'true'"> --preserve-attribute-splatting-order</RazorStyleAttributeOrderArguments>
  </PropertyGroup>

  <Target Name="RunRazorStyle"
          BeforeTargets="CoreCompile"
          AfterTargets="PreBuildEvent"
          Condition="
            '$(RazorStyleEnabled)' == 'true'
            and Exists('$(RazorStyleCliPath)')">
    <ItemGroup>
      <RazorStyleFiles Include="$(MSBuildProjectDirectory)\**\*.razor"
                       Exclude="$(MSBuildProjectDirectory)\bin\**\*;$(MSBuildProjectDirectory)\obj\**\*" />
    </ItemGroup>

    <Exec Command="&quot;$(_RazorStyleDotNetHost)&quot; &quot;$(RazorStyleCliPath)&quot; $(RazorStyleCommand) &quot;$(MSBuildProjectDirectory)&quot;$(RazorStyleDisabledRuleArguments)$(RazorStyleAttributeOrderArguments)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="'@(RazorStyleFiles)' != ''" />
  </Target>
</Project>
