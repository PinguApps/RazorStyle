<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PinguApps.RazorStyle</PackageId>
    <PackageIcon>icon.png</PackageIcon>
    <Description>MSBuild integration for RazorStyle formatting and linting.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);IncludeRazorStyleCliInPackage
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PinguApps.RazorStyle.CodeAnalysis\PinguApps.RazorStyle.CodeAnalysis.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\PinguApps.RazorStyle.CodeFixes\PinguApps.RazorStyle.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\PinguApps.RazorStyle.CodeAnalysis\bin\$(Configuration)\netstandard2.0\PinguApps.RazorStyle.CodeAnalysis.dll"
          Pack="true" PackagePath="analyzers\dotnet\cs\" Visible="false" />
    <None Include="..\PinguApps.RazorStyle.CodeFixes\bin\$(Configuration)\netstandard2.0\PinguApps.RazorStyle.CodeFixes.dll"
          Pack="true" PackagePath="analyzers\dotnet\cs\" Visible="false" />
    <None Include="buildTransitive\PinguApps.RazorStyle.props"
          Pack="true"
          PackagePath="buildTransitive\" />
    <None Include="buildTransitive\PinguApps.RazorStyle.targets"
          Pack="true"
          PackagePath="buildTransitive\" />
    <None Include="..\..\README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

  <Target Name="BuildEmbeddedRazorStyleCli" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="..\PinguApps.RazorStyle.Cli\PinguApps.RazorStyle.Cli.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="IncludeRazorStyleCliInPackage" DependsOnTargets="BuildEmbeddedRazorStyleCli">
    <ItemGroup>
      <TfmSpecificPackageFile Include="..\PinguApps.RazorStyle.Cli\bin\$(Configuration)\$(TargetFramework)\**\*"
                              Exclude="..\PinguApps.RazorStyle.Cli\bin\$(Configuration)\$(TargetFramework)\publish\**\*"
                              PackagePath="tools\$(TargetFramework)\" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Update="icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
